# Copy to .env.local for local dev, and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values. /demo works without any of these.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Bypasses access rules. Never prefix with NEXT_PUBLIC_ and never use in client code.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any long random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it to /api/cron/rotate.
CRON_SECRET=change-me

# Optional. The school's time zone, used to decide "today" for project start dates.
SCHOOL_TIME_ZONE=Asia/Manila
